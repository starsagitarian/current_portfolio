{
  "name": "starsagitarian-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Baiju Joseph's illustrated London portfolio: Next.js front end, Express API, PostgreSQL.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors blue,green \"npm run dev -w @starsagitarian/web\" \"npm run dev -w @starsagitarian/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && npm run lint -w @starsagitarian/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
