# Copy to .env and adjust. Real values never go in the repo.

# --- API (apps/api) ---
PORT=4000
LOG_LEVEL=info
# NODE_ENV=development

# PostgreSQL. Matches the local container in the README; hosted databases need DATABASE_SSL=true.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Requests per minute one client may make to /v1 before getting 429 responses.
RATE_LIMIT_PER_MINUTE=60

# --- Web (apps/web) ---
# Where the web server reaches the API (the résumé, the CV download).
API_URL=http://localhost:4000
# Where browsers send the contact form, when it differs from API_URL (inside Docker, say).
# PUBLIC_API_URL=http://localhost:4000
# Cloudflare Turnstile site key (public). Unset: Cloudflare's always-pass test key.
# TURNSTILE_SITE_KEY=

# --- docker compose (optional; defaults shown) ---
# WEB_PORT=3000
# API_PORT=4000
# POSTGRES_USER=portfolio
# POSTGRES_PASSWORD=portfolio
# POSTGRES_DB=portfolio

# --- Contact form (POST /v1/contact) ---
# Sites allowed to send messages from a browser (comma-separated; * matches one name part).
CORS_ORIGINS=http://localhost:3000
# Cloudflare's published test secret: every token passes. Production uses the real secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Any long random string; it keys the stored IP hashes.
IP_HASH_SALT=local-development-salt-change-me
CONTACT_LIMIT_PER_HOUR=5
# Messages a day, from everyone, that may arrive without the bot check (a browser without
# JavaScript posting the form itself). They are flagged in the alert email. 0 refuses them.
CONTACT_UNCHECKED_PER_DAY=5
# Leave these empty locally to store messages without emailing anyone.
RESEND_API_KEY=
CONTACT_ALERT_EMAIL=
# Bearer token for GET /cron/purge-contact-messages (at least 16 characters).
CRON_SECRET=
