  },
  "dependencies": {
    "@starsagitarian/shared": "*",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
