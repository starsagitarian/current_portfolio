{
  "name": "@starsagitarian/api",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio REST API: Express 5, TypeScript, Sequelize, PostgreSQL.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
